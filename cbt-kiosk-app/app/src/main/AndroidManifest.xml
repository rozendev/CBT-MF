<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Dibutuhkan ConnectivityManager. Tanpa ini setiap onResume melempar
        SecurityException, dan yang lebih buruk: HeartbeatManager menangkapnya
        diam-diam lalu melaporkan network="none" untuk SETIAP perangkat,
        selamanya — monitoring pengawas menampilkan seluruh armada seolah
        tidak punya jaringan.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="CBT-MF Kiosk"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CBTKiosk">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Layer 2: Home Launcher -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
                DIHAPUS dengan sengaja: intent-filter VIEW/application/zip.
                Filter itu membuat aplikasi apa pun di perangkat (file manager,
                share sheet, browser) bisa menyerahkan zip dan memicu pemasangan
                bundle tanpa autentikasi sama sekali. Bundle yang terpasang
                disajikan di origin tepercaya appassets.androidplatform.net yang
                punya CommsBridge, jadi zip buatan siswa = kendali penuh atas UI
                ujian, dan penyebarannya cukup lewat share sheet ke teman.
                Side-load yang sah tetap ada lewat tombol "Impor Bundle" di layar
                setup (ACTION_OPEN_DOCUMENT), yang merupakan tindakan sadar
                operator, bukan intent dari luar.
            -->
        </activity>
        
        <service
            android:name=".kiosk.KioskGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains exam kiosk lock state and detects exits during an active assessment" />
        </service>
            
    </application>
</manifest>
