{
    "name": "cbt-improved/computer-based-test",
    "description": "Modern Computer-Based Testing Platform with PHP, PostgreSQL, and Redis",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.5",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "ext-redis": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "react/http": "^1.10",
        "ratchet/pawl": "^0.4.1",
        "evenement/evenement": "^3.0",
        "predis/predis": "^2.2",
        "firebase/php-jwt": "^6.10",
        "phpoffice/phpspreadsheet": "^2.0",
        "symfony/mailer": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.52"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "rector": "rector process --dry-run"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
