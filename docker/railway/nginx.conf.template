# nginx.conf untuk deployment Railway satu container.
#
# Turunan dari docker/nginx/default.conf dengan tiga perbedaan:
#   1. listen memakai placeholder __PORT__ yang dirender entrypoint dari variabel PORT Railway.
#   2. fastcgi_pass ke 127.0.0.1:9000, bukan ke container 'php'.
#   3. Blok proxy /ws/ dibuang. WebSocket berjalan sebagai service Railway
#      terpisah dan alamat internalnya berbeda per proyek; lihat RAILWAY.md.
user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    # Railway menutup TLS di edge dan meneruskan HTTP ke container, jadi skema
    # aslinya cuma terbaca dari header ini.
    map $http_x_forwarded_proto $fastcgi_https {
        default $https;
        https on;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        text/xml
        image/svg+xml;

    server {
        listen __PORT__ default_server;

        server_name _;

        root /var/www/html/public;
        index index.php index.html index.htm;

        client_max_body_size 50M;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        # Log ke stdout/stderr supaya terbaca di panel log Railway.
        access_log /dev/stdout;
        error_log /dev/stderr;

        error_page 403 /errors/403.html;
        error_page 404 /errors/404.html;
        error_page 503 /errors/maintenance.html;

        location ^~ /errors/ {
            internal;
            root /usr/share/nginx/html;
        }

        location ~ /\. {
            deny all;
        }

        location / {
            if (-f /var/www/html/writable/.maintenance_redis) {
                return 503;
            }
            if (-f /var/www/html/writable/.maintenance_manual) {
                return 503;
            }
            try_files $uri $uri/ /index.php$is_args$args;
        }

        # Admin dan login tetap bisa diakses saat maintenance manual, supaya
        # mode-nya masih bisa dimatikan dari dalam aplikasi.
        location ^~ /admin {
            if (-f /var/www/html/writable/.maintenance_redis) {
                return 503;
            }
            try_files $uri $uri/ /index.php$is_args$args;
        }
        location ^~ /login {
            if (-f /var/www/html/writable/.maintenance_redis) {
                return 503;
            }
            try_files $uri $uri/ /index.php$is_args$args;
        }

        location ^~ /assets/ {
            expires 1y;
            access_log off;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        location ^~ /static/ {
            expires 0;
            access_log off;
            add_header Cache-Control "public, max-age=0, must-revalidate";
        }

        location ^~ /ui-bundle/ {
            expires 0;
            access_log off;
            add_header Cache-Control "public, max-age=0, must-revalidate";
            try_files $uri =404;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include /etc/nginx/fastcgi_params;
            fastcgi_param HTTPS $fastcgi_https if_not_empty;
        }

        location ~* \.(ico|css|js|gif|jpeg|jpg|png|woff|ttf|otf|woff2|eot)$ {
            expires 30d;
            access_log off;
            add_header Cache-Control "public";
        }
    }
}
