# Berkas ini CONTOH, bukan konfigurasi siap pakai.
# Nilai bertuliskan GANTI_... wajib diganti sebelum dipakai — jangan disalin
# apa adanya. Bangkitkan yang acak dengan: openssl rand -base64 24
# Cara termudah: jalankan 'sudo bash scripts/cbt.sh install'. Installer itu
# menulis .env dan src/.env secara utuh, jadi berkas ini tidak perlu disalin
# manual sama sekali.

# Database Configuration
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=cbt-mf
DB_USERNAME=cbt_user
DB_PASSWORD=GANTI_DENGAN_SANDI_ACAK
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_SANDI_ACAK_LAIN

# Buffer pool InnoDB. 256M untuk VPS 1 GB, 512M untuk 2 GB, 1G-2G untuk
# 4-8 GB. Kosong = 512M.
DB_BUFFER_POOL=

# Batas koneksi MariaDB. Kosong = 500.
DB_MAX_CONNECTIONS=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Password Redis. Dipakai run_backup, cache, dan sesi. Kosongkan bila
# Redis tidak memakai password.
REDIS_PASSWORD=

# Batas worker php-fpm. Kosong = 4x jumlah core, dirender entrypoint saat
# container start. Isi manual bila RAM terbatas (tiap worker ~30-60 MB).
PHP_FPM_MAX_CHILDREN=

# Cloudflare Tunnel Configuration
CF_TUNNEL_TOKEN=

# Container Names Configuration
CONTAINER_NGINX=ujian_nginx
CONTAINER_PHP=ujian_php
CONTAINER_WEBSOCKET=ujian_websocket
CONTAINER_CLOUDFLARED=ujian_cloudflared
CONTAINER_DB=ujian_mariadb
CONTAINER_REDIS=ujian_redis

# ── Rahasia tingkat aplikasi: BUKAN di berkas ini ───────────
# INTRUDER_TOKEN, KIOSK_APP_SECRET, dan CORS_ALLOWED_ORIGINS pernah tercantum
# di sini, dan tidak pernah berpengaruh apa pun. Berkas ini hanya dibaca
# docker-compose, dan compose cuma menyuntikkan DB_* dan REDIS_* ke container
# php. Ketiga kunci itu dibaca aplikasi lewat env(), yang sumbernya src/.env.
# Kunci yang diisi di sini tidak akan pernah sampai ke aplikasi.
#
# Tempatnya di src/.env. Penjelasan tiap kunci ada di src/env.
#
# 'cbt.sh install' sudah menuliskannya ke src/.env, termasuk membangkitkan
# INTRUDER_TOKEN dan menyulihkan nilainya ke var TOKEN di
# docker/nginx/html/errors/403.html dan 404.html. Halaman itu statis dan tidak
# bisa membaca berkas env sendiri, jadi kedua sisi harus disetel bersamaan.
