# Berkas ini CONTOH, bukan konfigurasi siap pakai.
# Nilai bertuliskan GANTI_... wajib diganti sebelum dipakai — jangan disalin
# apa adanya. Bangkitkan yang acak dengan: openssl rand -base64 24
# Cara termudah: jalankan ./install.sh, yang membangkitkan semuanya sendiri.

# Database Configuration
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=cbt-mf
DB_USERNAME=cbt_user
DB_PASSWORD=GANTI_DENGAN_SANDI_ACAK
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_SANDI_ACAK_LAIN

# Buffer pool InnoDB. 256M untuk VPS 1 GB, 512M untuk 2 GB, 1G-2G untuk
# 4-8 GB. Kosong = 512M.
DB_BUFFER_POOL=

# Batas koneksi MariaDB. Kosong = 500.
DB_MAX_CONNECTIONS=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Password Redis. Dipakai run_backup, cache, dan sesi. Kosongkan bila
# Redis tidak memakai password.
REDIS_PASSWORD=

# Batas worker php-fpm. Kosong = 4x jumlah core, dirender entrypoint saat
# container start. Isi manual bila RAM terbatas (tiap worker ~30-60 MB).
PHP_FPM_MAX_CHILDREN=

# Cloudflare Tunnel Configuration
CF_TUNNEL_TOKEN=

# Container Names Configuration
CONTAINER_NGINX=ujian_nginx
CONTAINER_PHP=ujian_php
CONTAINER_WEBSOCKET=ujian_websocket
CONTAINER_CLOUDFLARED=ujian_cloudflared
CONTAINER_DB=ujian_mariadb
CONTAINER_REDIS=ujian_redis

# ── Security ───────────────────────────────────────────────
# Shared secret for the intruder camera report API.
# WAJIB diganti dengan string acak panjang (mis. `openssl rand -hex 32`).
# Jika kosong, token default yang ada di source code akan dipakai (TIDAK AMAN).
INTRUDER_TOKEN=

# Opsional: shared secret tambahan untuk endpoint kiosk verify-exit.
# Jika diisi, hanya app kiosk yang mengirim secret ini yang bisa memverifikasi
# password keluaran kiosk. Kosongkan hanya jika semua deployment memakai
# rate-limit IP bawaan.
KIOSK_APP_SECRET=

# CORS origin yang diizinkan untuk bundled UI kiosk (WebView lokal).
# Pisahkan beberapa origin dengan koma.
CORS_ALLOWED_ORIGINS=https://appassets.androidplatform.net
